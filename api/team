function isAdmin(req) {
  const token = process.env.ADMIN_TOKEN;
  return Boolean(token && req.headers.authorization === `Bearer ${token}`);
}

function cleanText(value, max = 500) {
  return String(value ?? '').trim().slice(0, max);
}

function makeId(value) {
  return cleanText(value, 80)
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9_-]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

export default function handler(req, res) {
  if (req.method === 'GET') {
    return res.status(200).json(members);
  }

  if (!isAdmin(req)) {
    try {
      logIntrusion(getIP(req), 'unauth_team', 'Accès équipe non autorisé');
    } catch {}
    return res.status(401).json({ error: 'Non autorisé' });
  }

  if (req.method === 'POST') {
    const body = req.body || {};
    const name = cleanText(body.name, 80);

    if (!name) {
      return res.status(400).json({ error: 'Nom obligatoire' });
    }

    const id = makeId(body.id || name);

    if (!id) {
      return res.status(400).json({ error: 'Identifiant invalide' });
    }

    if (members.some(m => m.id === id)) {
      return res.status(409).json({ error: 'Ce membre existe déjà' });
    }

    const member = {
      id,
      name,
      status: cleanText(body.status, 50) || 'MEMBRE',
      country: cleanText(body.country, 50),
      countryFlag: cleanText(body.countryFlag, 8),
      joined: cleanText(body.joined, 10),
      streamSince: cleanText(body.streamSince, 10),
      role: cleanText(body.role, 80),
      category: cleanText(body.category, 120),
      description: cleanText(body.description, 800),
      tags: Array.isArray(body.tags)
        ? body.tags.map(x => cleanText(x, 40)).filter(Boolean).slice(0, 12)
        : [],
      twitch: cleanText(body.twitch, 300),
      youtube: cleanText(body.youtube, 300),
      discord: cleanText(body.discord, 300),
      initial: (cleanText(body.initial, 3) || name.charAt(0)).toUpperCase(),
      color: /^#[0-9a-f]{6}$/i.test(cleanText(body.color, 7))
        ? cleanText(body.color, 7)
        : '#151519',
      visible: body.visible !== false
    };

    members.push(member);
    return res.status(201).json({ ok: true, member });
  }

  if (req.method === 'PUT') {
    const body = req.body || {};
    const id = cleanText(body.id, 80);
    const index = members.findIndex(member => member.id === id);

    if (index === -1) {
      return res.status(404).json({ error: 'Membre introuvable' });
    }

    members[index] = {
      ...members[index],
      ...body,
      id
    };

    return res.status(200).json({
      ok: true,
      member: members[index]
    });
  }

  if (req.method === 'DELETE') {
    const id = cleanText(req.query?.id, 80);
    const before = members.length;

    members = members.filter(member => member.id !== id);

    return res.status(200).json({
      ok: true,
      deleted: before - members.length
    });
  }

  return res.status(405).json({
    error: 'Méthode non autorisée'
  });
}
