function auth(req){
  const token = process.env.ADMIN_TOKEN;
  return token && req.headers.authorization === `Bearer ${token}`;
}
function cleanText(v, max=500){ return String(v ?? '').trim().slice(0,max); }
function cleanMember(body, existing={}){
  const name = cleanText(body.name,80);
  const idRaw = cleanText(body.id || existing.id || name,80).toLowerCase();
  const id = idRaw.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9_-]+/g,'-').replace(/^-+|-+$/g,'') || Date.now().toString();
  return {
    id,
    name,
    status:cleanText(body.status,50) || 'MEMBRE',
    country:cleanText(body.country,50),
    countryFlag:cleanText(body.countryFlag,8),
    joined:cleanText(body.joined,10),
    streamSince:cleanText(body.streamSince,10),
    role:cleanText(body.role,80),
    category:cleanText(body.category,120),
    description:cleanText(body.description,800),
    tags:Array.isArray(body.tags) ? body.tags.map(x=>cleanText(x,40)).filter(Boolean).slice(0,12)
      : cleanText(body.tags,300).split(',').map(x=>x.trim()).filter(Boolean).slice(0,12),
    twitch:cleanText(body.twitch,300),
    youtube:cleanText(body.youtube,300),
    discord:cleanText(body.discord,300),
    initial:(cleanText(body.initial,3) || name.charAt(0) || '?').toUpperCase(),
    color:/^#[0-9a-f]{6}$/i.test(cleanText(body.color,7)) ? cleanText(body.color,7) : '#151519',
    visible: body.visible !== false && body.visible !== 'false'
  };
}

export default function handler(req,res){
  if(req.method === 'GET'){
    return res.status(200).json(members);
  }
  if(!auth(req)){
    logIntrusion(getIP(req),'unauth_team','Accès équipe sans autorisation');
    return res.status(401).json({error:'Non autorisé'});
  }
  if(req.method === 'POST'){
    const m = cleanMember(req.body || {});
    if(!m.name) return res.status(400).json({error:'Nom obligatoire'});
    if(members.some(x=>x.id===m.id)) return res.status(409).json({error:'Identifiant déjà utilisé'});
    members.push(m);
    return res.status(201).json({ok:true,member:m});
  }
  if(req.method === 'PUT'){
    const body=req.body || {};
    const id=cleanText(body.id,80);
    const idx=members.findIndex(x=>x.id===id);
    if(idx<0) return res.status(404).json({error:'Membre introuvable'});
    const updated=cleanMember(body,members[idx]);
    updated.id=id;
    members[idx]=updated;
    return res.status(200).json({ok:true,member:updated});
  }
  if(req.method === 'DELETE'){
    const id=cleanText(req.query?.id,80);
    const before=members.length;
    members=members.filter(x=>x.id!==id);
    return res.status(200).json({ok:true,deleted:before-members.length});
  }
  return res.status(405).json({error:'Méthode non autorisée'});
}
