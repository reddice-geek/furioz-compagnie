// ============================================================
// NETTOYAGE TEXTE
// ============================================================

function cleanText(
  value,
  max = 500
) {

  return String(
    value ?? ""
  )
    .trim()
    .slice(
      0,
      max
    );
}


// ============================================================
// CRÉATION IDENTIFIANT
// ============================================================

function makeId(
  value
) {

  return cleanText(
    value,
    80
  )

    .toLowerCase()

    .normalize(
      "NFD"
    )

    .replace(
      /[\u0300-\u036f]/g,
      ""
    )

    .replace(
      /[^a-z0-9_-]+/g,
      "-"
    )

    .replace(
      /^-+|-+$/g,
      ""
    );
}


// ============================================================
// RÉCUPÉRER LE BODY
// ============================================================

function getBody(req) {

  if (
    !req.body
  ) {

    return {};
  }


  if (
    typeof req.body ===
    "object"
  ) {

    return req.body;
  }


  try {

    return JSON.parse(
      req.body
    );

  }

  catch {

    return {};
  }
}


// ============================================================
// VÉRIFICATION ADMIN
// ============================================================

function isAdmin(req) {

  const adminToken =
    process.env.ADMIN_TOKEN;


  if (
    !adminToken
  ) {

    return false;
  }


  const authorization =
    req.headers.authorization ||
    "";


  return (
    authorization ===
    `Bearer ${adminToken}`
  );
}


// ============================================================
// CRÉER UN MEMBRE PROPRE
// ============================================================

function createMember(
  body,
  existing = {}
) {

  const name =
    cleanText(
      body.name ??
      existing.name,
      80
    );


  const initial =
    cleanText(
      body.initial ??
      existing.initial,
      3
    );


  const color =
    cleanText(
      body.color ??
      existing.color,
      7
    );


  let tags = [];


  if (
    Array.isArray(
      body.tags
    )
  ) {

    tags =
      body.tags

        .map(
          tag =>
            cleanText(
              tag,
              40
            )
        )

        .filter(
          Boolean
        )

        .slice(
          0,
          20
        );

  }

  else if (
    Array.isArray(
      existing.tags
    )
  ) {

    tags =
      existing.tags;
  }


  return {

    id:
      existing.id ||
      makeId(
        body.id ||
        name
      ),

    name:
      name,

    status:
      cleanText(
        body.status ??
        existing.status ??
        "MEMBRE",
        50
      ),

    country:
      cleanText(
        body.country ??
        existing.country,
        50
      ),

    countryFlag:
      cleanText(
        body.countryFlag ??
        existing.countryFlag,
        10
      ),

    joined:
      cleanText(
        body.joined ??
        existing.joined,
        60
      ),

    streamSince:
      cleanText(
        body.streamSince ??
        existing.streamSince,
        60
      ),

    role:
      cleanText(
        body.role ??
        existing.role,
        100
      ),

    category:
      cleanText(
        body.category ??
        existing.category,
        150
      ),

    description:
      cleanText(
        body.description ??
        existing.description,
        1500
      ),

    tags:
      tags,

    twitch:
      cleanText(
        body.twitch ??
        existing.twitch,
        300
      ),

    youtube:
      cleanText(
        body.youtube ??
        existing.youtube,
        300
      ),

    discord:
      cleanText(
        body.discord ??
        existing.discord,
        300
      ),

    initial:
      (
        initial ||
        name.charAt(0) ||
        "?"
      ).toUpperCase(),

    color:
      /^#[0-9a-f]{6}$/i.test(
        color
      )
        ? color
        : "#151519",

    visible:
      body.visible !== undefined
        ? body.visible !== false
        : existing.visible !== false
  };
}


// ============================================================
// API
// ============================================================

export default function handler(
  req,
  res
) {

  // Empêche la mise en cache
  res.setHeader(
    "Cache-Control",
    "no-store, no-cache, must-revalidate"
  );


  // ========================================================
  // GET
  // Lire les membres
  // ========================================================

  if (
    req.method ===
    "GET"
  ) {

    return res
      .status(200)
      .json(
        members
      );
  }


  // ========================================================
  // ADMIN obligatoire
  // ========================================================

  if (
    !process.env.ADMIN_TOKEN
  ) {

    return res
      .status(503)
      .json({
        error:
          "ADMIN_TOKEN n'est pas configuré sur Vercel."
      });
  }


  if (
    !isAdmin(req)
  ) {

    return res
      .status(401)
      .json({
        error:
          "Non autorisé"
      });
  }


  // ========================================================
  // POST
  // Ajouter
  // ========================================================

  if (
    req.method ===
    "POST"
  ) {

    const body =
      getBody(req);


    const name =
      cleanText(
        body.name,
        80
      );


    if (
      !name
    ) {

      return res
        .status(400)
        .json({
          error:
            "Le nom est obligatoire."
        });
    }


    const id =
      makeId(
        body.id ||
        name
      );


    if (
      !id
    ) {

      return res
        .status(400)
        .json({
          error:
            "Identifiant invalide."
        });
    }


    const exists =
      members.some(
        member =>
          member.id ===
          id
      );


    if (
      exists
    ) {

      return res
        .status(409)
        .json({
          error:
            "Ce membre existe déjà."
        });
    }


    const member =
      createMember({
        ...body,
        id
      });


    members.push(
      member
    );


    return res
      .status(201)
      .json({

        ok:
          true,

        message:
          "Membre ajouté.",

        member:
          member
      });
  }


  // ========================================================
  // PUT
  // Modifier
  // ========================================================

  if (
    req.method ===
    "PUT"
  ) {

    const body =
      getBody(req);


    const id =
      cleanText(
        body.id,
        80
      );


    if (
      !id
    ) {

      return res
        .status(400)
        .json({
          error:
            "Identifiant du membre manquant."
        });
    }


    const index =
      members.findIndex(
        member =>
          member.id ===
          id
      );


    if (
      index === -1
    ) {

      return res
        .status(404)
        .json({
          error:
            "Membre introuvable."
        });
    }


    const oldMember =
      members[index];


    const updatedMember =
      createMember(
        body,
        oldMember
      );


    updatedMember.id =
      oldMember.id;


    members[index] =
      updatedMember;


    return res
      .status(200)
      .json({

        ok:
          true,

        message:
          "Membre modifié.",

        member:
          updatedMember
      });
  }


  // ========================================================
  // DELETE
  // Supprimer
  // ========================================================

  if (
    req.method ===
    "DELETE"
  ) {

    const id =
      cleanText(
        req.query?.id,
        80
      );


    if (
      !id
    ) {

      return res
        .status(400)
        .json({
          error:
            "Identifiant du membre manquant."
        });
    }


    const member =
      members.find(
        item =>
          item.id ===
          id
      );


    if (
      !member
    ) {

      return res
        .status(404)
        .json({
          error:
            "Membre introuvable."
        });
    }


    members =
      members.filter(
        item =>
          item.id !==
          id
      );


    return res
      .status(200)
      .json({

        ok:
          true,

        message:
          "Membre supprimé.",

        deleted:
          id
      });
  }


  // ========================================================
  // AUTRE
  // ========================================================

  res.setHeader(
    "Allow",
    "GET, POST, PUT, DELETE"
  );


  return res
    .status(405)
    .json({
      error:
        "Méthode non autorisée."
    });
}
